# The real values are kept in the private prodbytes/setec-astronomy repo
# (grigri.nu01/.env); scripts/link-private.sh links them in. Otherwise,
# copy this to .env (gitignored) and fill it in.
#
# Build settings reach the Flutter app with --dart-define, but only the
# names listed in scripts/dart-defines.sh (public values; never secrets).
# The deploy settings below are read by scripts/deploy.sh only.

# The API's site (it serves /api and /photos). Optional: the web app uses
# its own origin, and Android and iOS default to the stage's site
# (https://grigri.nu01.com for GRIGRI_STAGE=prod, https://rc.grigri.nu01.com
# otherwise). Set it to point a phone at a local API, e.g.
# https://<your machine>:7189.
GRIGRI_API_URL=

# Google sign-in: the OAuth client IDs (public, not secrets) of the Google
# Cloud project. The web client ID is the audience the API checks, on every
# platform (Android and iOS use it as the server client ID). The app always
# signs in with Google, so a local build needs it too.
GOOGLE_WEB_CLIENT_ID=
# The local site (devbox services up, https://local.grigri.nu01.com:2543)
# signs in with its own web client, whose JavaScript origins are the local
# site's; the local API checks it too. Without it they use GOOGLE_WEB_CLIENT_ID,
# which Google refuses on the local site unless that client lists its origin.
GOOGLE_WEB_CLIENT_ID_LOCAL=
# iOS only: its client ID; scripts/dart-defines.sh also writes it, and its
# reversed URL scheme, to the git-ignored ios/Flutter/Private.xcconfig.
GOOGLE_IOS_CLIENT_ID=

# iOS: your Apple development team ID (Xcode > Settings > Accounts; a free
# Personal Team works for development installs). Written to the git-ignored
# grigri_app/ios/Flutter/Private.xcconfig, never committed.
IOS_DEVELOPMENT_TEAM=

# Deploys (scripts/deploy.sh): the site's Route 53 zone, grigri.nu01.com's.
HOSTED_ZONE_ID=

# The API (grigri_api): the Google web OAuth client whose ID tokens it
# trades for its own sessions (POST /api/session). A public identifier.
# Locally, leave it empty for dev mode (no Google sign-in: callers name
# themselves with X-Grigri-Dev-User, or POST {"devUser"} to /api/session);
# deploys need it (the repository variable GOOGLE_WEB_CLIENT_ID in CI).
GOOGLE_WEB_CLIENT_ID=
# Deploys (scripts/deploy.sh): an rbacr API token owned by an rbacr root
# (rbacr.nu01.com > Global > API tokens), with which the API asks rbacr
# who holds grigri's admin role (the repository secret GRIGRI_RBACR_TOKEN
# in CI). Optional: without it nobody is an admin. Locally the API asks
# the local rbacr with RBACR_TOKEN instead.
GRIGRI_RBACR_TOKEN=

# Match scores (https://aityx.ai): the aityx API key, a secret (the
# repository secret GRIGRI_AITYX_API_KEY in CI; Floci takes it from here
# too). The API runs the match model with it for admins' decks, and the
# scoring function (scripts/score-matches.sh) for every profile and plan.
# Optional: without it, no scores. GRIGRI_AITYX_URL defaults to
# https://api.aityx.ai; a stage key needs aityx's stage.
GRIGRI_AITYX_API_KEY=
GRIGRI_AITYX_URL=

# Premium (specs/premium.md): Stripe's secret key (sk_test_... here: test
# mode) and its webhook endpoint's signing secret (whsec_...), secrets
# (GRIGRI_STRIPE_SECRET_KEY / GRIGRI_STRIPE_WEBHOOK_SECRET in CI, live mode;
# the _RC ones, test mode, for RC). Floci takes them from here too.
# Optional: without both, no Premium.
GRIGRI_STRIPE_SECRET_KEY=
GRIGRI_STRIPE_WEBHOOK_SECRET=

# Sign in with Apple's key (specs/sign-in.md), for scripts/deploy.sh: the
# Apple Developer team ID, the Sign in with Apple key's ID, and the key's
# .p8 file as its base64 body on one line (no BEGIN/END lines), a secret
# (GRIGRI_APPLE_TEAM_ID and GRIGRI_APPLE_KEY_ID variables and the
# GRIGRI_APPLE_PRIVATE_KEY secret in CI). Optional: without all three, the
# API doesn't keep Apple refresh tokens, so it can't revoke them when an
# account is deleted. Sign in with Apple itself needs none of them.
GRIGRI_APPLE_TEAM_ID=
GRIGRI_APPLE_KEY_ID=
GRIGRI_APPLE_PRIVATE_KEY=

# Origin check (specs/origin-check.md): what the site's CloudFront sends the
# API so it answers only through the site. Optional: scripts/deploy.sh
# derives one per stage from GRIGRI_RBACR_TOKEN. 32+ of A-Z a-z 0-9 _ -.
GRIGRI_ORIGIN_SECRET=

# Roles (rbacr, https://rbacr.nu01.com). For development, `devbox services up`
# runs rbacr's dev server on http://localhost:2115, which the local API asks
# for admins and the user's roles (the app only talks to the API).
# RBACR_TOKEN is the dev server's root token: generate one with
#   node -e "console.log('rbacr_'+require('crypto').randomBytes(32).toString('base64url'))"
# or copy the one it logs on first start. Never put it in the app.
RBACR_TOKEN=

# Google sign-in OAuth clients (Google Cloud project grigri-511416). Client
# IDs are public identifiers; never put a client secret here. The Android
# client is matched by package name and signing SHA-1, so the app doesn't
# need its ID compiled in; it's kept here for reference.
GOOGLE_ANDROID_CLIENT_ID_GA=
