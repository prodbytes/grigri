<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Grigri's privacy manifest (specs/app-store.md): no tracking; the data the
  app collects, all linked to the user and used only for the app's
  functionality; and the required-reason APIs the app's own code uses.
  Keep it in step with the App Privacy answers in App Store Connect and with
  grigri_index/site/privacy.html.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
