# The real values are kept in the private prodbytes/setec-astronomy repo
# (grigri.nu01/.env); scripts/link-private.sh links them in. Otherwise,
# copy this to .env (gitignored) and fill it in.
#
# Build settings reach the Flutter app with --dart-define, but only the
# names listed in scripts/dart-defines.sh (public values; never secrets).
# The deploy settings below are read by scripts/deploy.sh only.

# iOS: your Apple development team ID (Xcode > Settings > Accounts; a free
# Personal Team works for development installs). Written to the git-ignored
# grigri_app/ios/Flutter/Private.xcconfig, never committed.
IOS_DEVELOPMENT_TEAM=

# Deploys (scripts/deploy.sh): the site's Route 53 zone, grigri.nu01.com's.
HOSTED_ZONE_ID=
# Deploys: who is emailed when the site's health check fails or recovers,
# comma-separated.
GRIGRI_HEALTH_EMAILS=

# The API (grigri_api): the Google web OAuth client whose ID tokens it
# trades for its own sessions (POST /api/session). A public identifier.
# Locally, leave it empty for dev mode (no Google sign-in: callers name
# themselves with X-Grigri-Dev-User, or POST {"devUser"} to /api/session);
# deploys need it (the repository variable GOOGLE_WEB_CLIENT_ID in CI).
GOOGLE_WEB_CLIENT_ID=
# Who may approve or reject any join request, comma-separated verified
# Google emails (the repository secret GRIGRI_ADMIN_EMAILS in CI). Locally,
# the dev-mode emails to treat as admins.
GRIGRI_ADMIN_EMAILS=
